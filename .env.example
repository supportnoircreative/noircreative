# Contact form delivery (route: src/app/api/contact/route.js, sent via Resend)
# Resend API key — get one at https://resend.com/api-keys
RESEND_API_KEY=re_xxxxxxxxxxxxxxxx
# Inbox that receives new project inquiries
CONTACT_EMAIL=support@noircreative.com
# Verified sender — must match a domain/address verified in your Resend account
# (noir@noircreative.com only works after you verify the noircreative.com domain)
# RESEND_FROM_EMAIL=Noir Creative <noir@noircreative.com>
# Public site URL used in the acknowledgment email footer
# SITE_URL=https://noircreative.com
