# Contact form delivery (route: src/app/api/contact/route.js, sent via Resend)

# Resend API key — get one at https://resend.com/api-keys
RESEND_API_KEY=re_xxxxxxxxxxxxxxxx

# Inbox that receives new project inquiries.
# This is the Hostinger mailbox, so it needs the MX records pointing at
# Hostinger to actually receive anything.
CONTACT_EMAIL=info@noircreativellc.com

# Verified sender. Must be on a domain verified in your Resend account, which
# is a separate step from Hostinger mail: Hostinger handles RECEIVING (MX),
# Resend handles SENDING (SPF + DKIM). Both can coexist on one domain, but
# there must be only ONE SPF record, including both services.
RESEND_FROM_EMAIL=Noir Creative <info@noircreativellc.com>

# Public site URL used in the acknowledgment email footer
SITE_URL=https://www.noircreativellc.com
